NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TZ=Asia/Dhaka

DB_HOST=localhost
DB_PORT=5432
DB_USER=bbs_meeting
DB_PASSWORD=
DB_NAME=bbs_meeting
# DB_POOL_MAX=10                 # optional: pg pool size (default 5 in development/test, 10 in production)
# DB_CONNECTION_TIMEOUT_MS=10000 # optional: wait for a DB connection at most this long, then fail (cron jobs retry next tick)
# DB_IDLE_TIMEOUT_MS=30000     # optional: close idle pooled connections after this long

JWT_ACCESS_SECRET=at_least_32_random_characters
JWT_REFRESH_SECRET=another_32_random_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BBS সভা সূচি <no-reply@bbs.gov.bd>"
MAIL_DRY_RUN=true            # true = log mails instead of sending (development)

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2
# v1.11: meeting minutes files, v1.13 also the meeting notices in notices/ (PDF/DOCX/JPEG/PNG). Private: never served statically. Production: persistent
# storage, included in backups, writable only by the app user.
DECISION_UPLOAD_DIR=./storage/uploads
SWAGGER_ENABLED=true

SEED_SUPER_ADMIN_EMAIL=admin@bbs.gov.bd
SEED_SUPER_ADMIN_PASSWORD=
SEED_OFFICER_DEFAULT_PASSWORD=   # development only; leave empty in production

# v1.6: test-only hooks for Playwright (POST /api/v1/test-hooks/reset-throttle, admin).
# Development/test only; the app refuses to start with true in production.
E2E_TEST_HOOKS=false

# v1.21 part 2: AI notice extractor (admin → সেটিংস → "AI"). Optional: empty = AI option unavailable,
# the local OCR is used. When AI is on, the notice content is sent to Anthropic (SECURITY.md) — get the
# office's approval first. Secret: only here in .env, never commit it.
ANTHROPIC_API_KEY=
NOTICE_AI_MODEL=claude-haiku-5-5
NOTICE_AI_TIMEOUT_MS=30000
