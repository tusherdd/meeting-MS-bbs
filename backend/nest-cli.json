{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "ignore": ["**/*.spec.ts"]
      }
    },
    "typeCheck": false,
    "assets": [
      {
        "include": "../assets/fonts/*",
        "outDir": "dist/assets",
        "watchAssets": false
      }
    ]
  }
}
