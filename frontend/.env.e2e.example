# Playwright only (copy to .env.e2e, which is git-ignored).
# An ADMIN / SUPER_ADMIN account that has already changed its first password.
# It is used only to create (or reset) the dedicated test officer e2e-officer@example.com.
E2E_ADMIN_EMAIL=admin@bbs.gov.bd
E2E_ADMIN_PASSWORD=
# Optional: the default officer password (else the DEFAULT_OFFICER_PASSWORD line of backend/.env is read).
E2E_OFFICER_PASSWORD=
